# runs/ contain raw council dossiers including the user's verbatim prompts.
# Do not commit without review.
# KEEP THIS RULE UNANCHORED (no leading slash): the engine writes dossiers to
# wise-counsil/runs/ inside the package, and the unanchored pattern is what
# keeps those gitignored. Anchoring it to /runs/ would expose raw user prompts
# to a casual `git add .`.
runs/
*.key
.env

# Eval raw transcripts: full model outputs on task prompts. Machine-written;
# keep only the summarized artifacts under eval/results/ (not raw/).
eval/results/raw/

# Internal session handoffs (machine paths, personal context) — not part of
# the public story. STATUS.md is the public-facing chart.
HANDOFF-*.md

# Local agent-harness config and project-scoped third-party skills.
# Anyone who wants them can install with one command; they are not part of
# this repo's deliverable.
.claude/

# Python bytecode from the eval graders (tests run candidate solutions).
__pycache__/
